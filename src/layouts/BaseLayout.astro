---
import Nav from "../components/Nav.astro"

export interface Props {
  title: string
  description: string
  type?: "website" | "article"
  image?: string
  imageAlt?: string
  publishedTime?: Date | string
  modifiedTime?: Date | string
  author?: string
  structuredData?: Record<string, unknown>
}

const {
  title,
  description,
  type = "website",
  image = "/social/og-default.png",
  imageAlt = "Noodle terminal REST client",
  publishedTime,
  modifiedTime,
  author,
  structuredData,
} = Astro.props
const site = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, site)
const socialImage = new URL(image, site)
const toISOString = (date: Date | string) => new Date(date).toISOString()
const jsonLd = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Noodle Blog" href={new URL("/rss.xml", site)} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", site)} />
    <meta property="og:site_name" content="Noodle" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {publishedTime && type === "article" && <meta property="article:published_time" content={toISOString(publishedTime)} />}
    {modifiedTime && type === "article" && <meta property="article:modified_time" content={toISOString(modifiedTime)} />}
    {author && type === "article" && <meta property="article:author" content={author} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <link rel="icon" href="/favicon.ico?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;1,400&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style is:global>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg: #181613;
        --bg-elevated: #201d19;
        --bg-card: #24211d;
        --panel: #24211d;
        --fg: #f3efe7;
        --muted: #aaa39a;
        --accent: #59c9be;
        --accent-glow: transparent;
        --accent-dim: #3daaa1;
        --border: #3b3630;
        --border-hover: #514a42;
        --rule: rgba(243, 239, 231, 0.12);
        --violet: #59c9be;
        --cyan: #59c9be;
        --green: #9dcb82;
        --orange: #f0a96b;
        --noodle: #f2c65a;
        --coral: #ef7b63;
        --coral-ink: #9b3f31;
        --ivory: #eee7da;
        --ivory-ink: #211e1a;
        --section-space: clamp(3rem, 4vw, 4.5rem);
        --shadow-strong: rgba(0, 0, 0, 0.35);
        --mask-ink: #000;
        --font-display: 'Bodoni Moda', Georgia, serif;
        --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --accent-text: var(--bg);

        /* Centralized Noodle accents */
        --color-orange: var(--orange);
        --color-green: var(--green);
        --color-blue: #89b4fa;
        --color-red: #f38ba8;
        --color-purple: var(--violet);
        --color-yellow: #f9e2af;
      }

      [data-theme="light"],
      .sl-theme-light {
        --bg: #eff1f5;
        --bg-elevated: #e6e9ef;
        --bg-card: #dce0e8;
        --fg: #4c4f69;
        --muted: #5c5f77;
        --accent: #7287fd;
        --accent-glow: transparent;
        --accent-dim: #5f6cf0;
        --border: #ccd0da;
        --border-hover: #bcc0cc;
        --shadow-strong: rgba(76, 79, 105, 0.2);
        --color-orange: #fe640b;
        --color-green: #40a02b;
        --color-blue: #1e66f5;
        --color-red: #d20f39;
        --color-purple: #7c24ec; /* Darkened for WCAG AA contrast (4.51:1) */
        --color-yellow: #df8e1d;
        --accent-text: #11111b; /* Dark text for high contrast on light theme accent */
      }

      html {
        scroll-behavior: smooth;
        background: var(--bg);
      }

      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .content-wrapper {
        flex: 1 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
      }

      :is(h1, h2, h3) {
        text-wrap: balance;
      }

      p {
        text-wrap: pretty;
      }

      ::selection {
        color: var(--ivory-ink);
        background: var(--noodle);
      }

      * {
        scrollbar-color: var(--border-hover) var(--bg);
        scrollbar-width: thin;
      }

      *::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      *::-webkit-scrollbar-track {
        background: var(--bg);
      }

      *::-webkit-scrollbar-thumb {
        background: var(--border-hover);
        border: 2px solid var(--bg);
      }

      a,
      button {
        -webkit-tap-highlight-color: transparent;
      }

      :focus-visible {
        outline: 2px solid var(--color-blue);
        outline-offset: 3px;
      }

      .site-footer {
        text-align: center;
        padding: 2rem 1.25rem;
        color: var(--muted);
        font-size: 0.75rem;
        border-top: 1px solid var(--border);
        margin-top: 4rem;
      }

      .footer-line {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.25rem 0.6rem;
      }

      .site-footer a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.2s;
      }

      .site-footer a:hover {
        color: var(--fg);
      }

      .footer-separator {
        color: var(--border-hover);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <Nav />

    <div class="content-wrapper">
      <slot />
    </div>

    <footer class="site-footer">
      <nav class="footer-line" aria-label="Footer navigation">
        <a href="https://github.com/wilfredinni/noodle">GitHub</a>
        <span class="footer-separator" aria-hidden="true">·</span>
        <a href="https://app.notion.com/p/39128d9edba9809da834f351332baf57?v=39228d9edba98042ad07000cdbe5d751">Roadmap</a>
        <span class="footer-separator" aria-hidden="true">·</span>
        <a href="/releases/">Releases</a>
        <span class="footer-separator" aria-hidden="true">·</span>
        <a href="https://github.com/wilfredinni/noodle/issues">Issues</a>
        <span class="footer-separator" aria-hidden="true">·</span>
        <span>Apache-2.0</span>
      </nav>
    </footer>
  </body>
</html>
