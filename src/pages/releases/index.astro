---
import ArticleIndex from "../../components/ArticleIndex.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { ARTICLES_PER_PAGE, getArticles } from "../../lib/articles"

const releases = await getArticles("release")
const lastPage = Math.ceil(releases.length / ARTICLES_PER_PAGE)
---

<BaseLayout title="Releases · Noodle" description="Noodle release notes, updates, and the thinking behind what shipped.">
  <ArticleIndex
    title="Release notes"
    description="What changed in each Noodle release, why it matters, and how it fits into the terminal workflow."
    posts={releases.slice(0, ARTICLES_PER_PAGE)}
    emptyMessage="No release notes have been published yet."
    pagination={{ currentPage: 1, lastPage, basePath: "/releases" }}
  />
</BaseLayout>
