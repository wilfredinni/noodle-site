---
import ArticleIndex from "../../components/ArticleIndex.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { ARTICLES_PER_PAGE, getArticles } from "../../lib/articles"

const posts = await getArticles()
const lastPage = Math.ceil(posts.length / ARTICLES_PER_PAGE)
---

<BaseLayout title="Blog · Noodle" description="The latest updates, guides, and announcements from the Noodle terminal REST client team.">
  <ArticleIndex
    title="Inside Noodle"
    description="Updates, architecture, and feature deep-dives from the creators of the terminal REST client."
    posts={posts.slice(0, ARTICLES_PER_PAGE)}
    pagination={{ currentPage: 1, lastPage, basePath: "/blog" }}
  />
</BaseLayout>
