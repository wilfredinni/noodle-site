---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
---

<BaseLayout title="Blog · Noodle" description="The latest updates, guides, and announcements from the Noodle terminal REST client team.">
  <main class="blog-container">
    <header class="blog-header">
      <h1 class="blog-title">Inside Noodle</h1>
      <p class="blog-desc">
        Updates, architecture, and feature deep-dives from the creators of the terminal REST client.
      </p>
    </header>

    {posts.length === 0 ? (
      <div class="empty-state">
        <p>No blog posts found. Check back soon!</p>
      </div>
    ) : (
      <div class="blog-list-rows">
        {posts.map((post) => (
          <article class="blog-post-row">
            <a href={`/blog/${post.id}/`} class="post-row-link">
              <h2 class="post-title">{post.data.title}</h2>
              <div class="post-meta-right">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="post-tag">#{tag}</span>
                ))}
                <span class="post-arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: var(--bg) url("data:image/svg+xml,%3Csvg viewBox='0 0 1600 1500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke-linecap='round'%3E%3Cpath d='M-180 310C260 20 470 610 910 420S1390 610 1780 190' stroke='%23f2c65a' stroke-width='28' opacity='.075'/%3E%3Cpath d='M1780 1080C1330 820 1160 1390 720 1190S210 910-180 1310' stroke='%2359c9be' stroke-width='20' opacity='.055'/%3E%3Cpath d='M-180 330C260 40 470 630 910 440S1390 630 1780 210' stroke='%23f3efe7' stroke-width='3' opacity='.035'/%3E%3C/g%3E%3C/svg%3E") top center / max(100vw, 960px) 1500px repeat-y;
  }

  .blog-container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 4vw, 2.5rem) 6rem;
  }

  .blog-header {
    max-width: 760px;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .blog-title {
    max-width: 10ch;
    margin: 0 0 1.25rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .blog-title::after {
    display: block;
    width: min(4.5em, 100%);
    height: 8px;
    margin-top: 1.25rem;
    background: var(--noodle);
    content: "";
    transform: rotate(-1deg);
  }

  .blog-desc {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .empty-state {
    text-align: center;
    padding: 6rem 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 16px;
    color: var(--muted);
  }

  .blog-list-rows {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .blog-post-row {
    border-bottom: 1px solid var(--border);
  }

  .blog-post-row:first-child {
    border-top: 1px solid var(--border);
  }

  .post-row-link {
    display: flex;
    align-items: center;
    min-height: 112px;
    gap: 2rem;
    padding: 1.5rem 0;
    text-decoration: none;
    color: inherit;
  }

  .post-row-link:hover,
  .post-row-link:focus-visible {
    outline: 2px solid transparent;
  }

  .post-title {
    flex-grow: 1;
    margin: 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    transition: color 0.2s;
  }

  .post-row-link:hover .post-title,
  .post-row-link:focus-visible .post-title {
    color: var(--accent);
  }

  .post-meta-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }

  .post-tag {
    font-family: var(--font-mono);
    color: var(--coral);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .post-arrow {
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 700;
    transition: transform 0.2s, color 0.2s;
  }

  .post-row-link:hover .post-arrow,
  .post-row-link:focus-visible .post-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 650px) {
    .post-row-link {
      flex-direction: column;
      align-items: flex-start;
      min-height: 0;
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .post-meta-right {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: 4rem 1.25rem 4rem;
    }
  }
</style>
