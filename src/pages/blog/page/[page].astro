---
import type { GetStaticPaths, Page } from "astro"
import type { CollectionEntry } from "astro:content"
import ArticleIndex from "../../../components/ArticleIndex.astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { ARTICLES_PER_PAGE, getArticles } from "../../../lib/articles"

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getArticles()
  return paginate(posts, { pageSize: ARTICLES_PER_PAGE }).slice(1)
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page<CollectionEntry<"blog">> }
---

<BaseLayout title={`Blog · Page ${page.currentPage} · Noodle`} description="The latest updates, guides, and announcements from the Noodle terminal REST client team." image="/social/blog.png">
  <ArticleIndex
    kicker="Noodle journal"
    title="Inside Noodle"
    description="Updates, architecture, and feature deep-dives from the creators of the terminal REST client."
    posts={page.data}
    pagination={{ currentPage: page.currentPage, lastPage: page.lastPage, basePath: "/blog" }}
  />
</BaseLayout>
