---
import BaseLayout from "../layouts/BaseLayout.astro"
import HeroSection from "../components/landing/HeroSection.astro"
import InstallPill from "../components/InstallPill.astro"
import { getArticles } from "../lib/articles"
import update from "../../public/update.json"

const [latestRelease] = await getArticles("release")

const capabilities = [
  ["Requests", "URL, params, headers, body, and auth", "/docs/guides/using-the-request-pane/"],
  ["Responses", "Text, image previews, binary downloads, headers, cookies, and results", "/docs/guides/using-the-response-pane/"],
  ["Collections", "Folders, inherited context, and Git-friendly files", "/docs/guides/collections/"],
  ["Environments", "Switchable variables and secure values", "/docs/guides/using-environments/"],
  ["Scripting", "Inline pre/post processing, seeded test data, and explicit persistence", "/docs/guides/pre-request-scripting/"],
  ["Transport", "Proxy, TLS, mTLS, and authentication", "/docs/guides/proxies-and-tls/"],
  ["Portability", "Import OpenAPI, Swagger, Postman, and Insomnia. Export OpenAPI and Postman.", "/docs/import/import/"],
  ["Testing", "Response assertions, scripted tests, and JSON Schema validation", "/docs/guides/scripted-tests/"],
  ["Collection Runner", "Ordered runs, tag filters, and CSV or JSON iteration data", "/docs/guides/collection-runner/"],
  ["Chaining", "Capture response values and reuse them in later requests", "/docs/guides/captures/"],
  ["Automation", "Headless CLI runs, CI exit codes, and structured JSON results", "/docs/guides/automation/"],
  ["Visualization", "Search and explore JSON or XML responses as trees and tables", "/docs/guides/using-the-response-pane/#source-and-visual"],
]

const site = Astro.site ?? Astro.url
const homeUrl = new URL("/", site).href
const homeDescription = "Keep API requests, scripts, and tests versioned in Git alongside your code. Use the same collection from the TUI, CLI, CI, or a coding agent."
const homeStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: "Noodle REST",
      alternateName: "Noodle",
      url: homeUrl,
      description: homeDescription,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${homeUrl}#software`,
      name: "Noodle REST",
      alternateName: "Noodle",
      url: homeUrl,
      description: homeDescription,
      applicationCategory: "DeveloperApplication",
      operatingSystem: ["macOS", "Linux"],
      softwareVersion: update.version.replace(/^v/, ""),
      downloadUrl: new URL("/install.sh", site).href,
      codeRepository: "https://github.com/wilfredinni/noodle",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      image: new URL("/social/og-default.png", site).href,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
}
---

<BaseLayout
  title="Noodle REST | The Repository is the Workspace"
  description={homeDescription}
  structuredData={homeStructuredData}
>
  <HeroSection latestRelease={latestRelease} />

  <main class="landing">
    <section id="features" class="feature-list" aria-label="Noodle features">
      <article class="feature-row">
        <div class="feature-copy">
          <h2><a href="/docs/reference/collection-format/">Requests that belong in the repository.<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></h2>
          <p>Every request is a readable YAML file. Edit it in Noodle or your editor, review it in Git, and keep it beside the code it exercises.</p>
        </div>

        <div class="code-proof" aria-label="Example request file">
          <div class="proof-bar">collections/users/get.yml</div>
          <pre><code><span class="syntax-violet">name:</span> Get user
<span class="syntax-violet">method:</span> <span class="syntax-orange">GET</span>
<span class="syntax-violet">url:</span> <span class="syntax-cyan">"$base_url/users/:id"</span>
<span class="syntax-violet">headers:</span>
  Accept: <span class="syntax-cyan">application/json</span>
<span class="syntax-violet">params:</span>
  id: <span class="syntax-green">42</span></code></pre>
        </div>
      </article>

      <article class="feature-row">
        <div class="feature-copy">
          <h2><a href="/docs/guides/using-the-response-pane/">The whole exchange, without leaving the terminal.<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></h2>
          <p>Compose a request, send it, then move through body, headers, cookies, and timing from the same keyboard-first workspace.</p>
        </div>

        <div class="exchange-proof" aria-label="Response inspector showing a successful PUT request">
          <div class="response-toolbar">
            <span class="request-method">PUT</span>
            <code>/users/42</code>
            <span class="response-status">200 OK</span>
            <span class="response-time">87ms</span>
          </div>
          <div class="response-tabs" aria-label="Available response views">
            <span class="is-active">Body</span>
            <span>Headers <b>12</b></span>
            <span>Cookies <b>2</b></span>
            <span>Timeline</span>
          </div>
          <pre class="response-body"><code>&#123;
  <span class="syntax-violet">"id"</span>: <span class="syntax-green">42</span>,
  <span class="syntax-violet">"name"</span>: <span class="syntax-cyan">"Ada Lovelace"</span>,
  <span class="syntax-violet">"role"</span>: <span class="syntax-cyan">"developer"</span>
&#125;</code></pre>
        </div>
      </article>

      <article class="feature-row">
        <div class="feature-copy">
          <h2><a href="/docs/guides/using-environments/">Environment-aware without leaking secrets.<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></h2>
          <p>Switch between development, staging, and production variables. Secret declarations stay in the file while values live in the OS credential vault or process environment.</p>
        </div>

        <div class="environment-proof" aria-label="Environment and secret state">
          <div><strong><i class="dot dot-green"></i>development</strong><span>active</span></div>
          <div><strong><i class="dot dot-orange"></i>staging</strong><span>ready</span></div>
          <div><strong><i class="dot dot-violet"></i>production</strong><span>ready</span></div>
          <div class="secret-row"><code>API_TOKEN</code><span>OS credential vault</span></div>
        </div>
      </article>

      <article class="feature-row">
        <div class="feature-copy">
          <h2><a href="/docs/guides/automation/">One collection, more than one way to work.<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></h2>
          <p>Explore interactively in the TUI, chain captured response values across ordered runs, enforce response assertions, or give coding agents the supported Noodle skill.</p>
        </div>

        <div class="terminal-proof" aria-label="Noodle CLI and agent commands">
          <div><span>$</span><code>noodle collection run ./api --env staging --json</code></div>
          <div><span>$</span><code>noodle agent install</code></div>
        </div>
      </article>
    </section>

    <section class="capability-section" aria-labelledby="capability-title">
      <header>
        <div><span class="section-kicker">The complete workbench</span><h2 id="capability-title">The rest of the workflow</h2></div>
        <p>Focused enough to stay fast, complete enough to handle real API work.</p>
      </header>

      <div class="capability-grid">
        {capabilities.map(([title, body, href]) => (
          <article>
            <h3><a href={href}>{title}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></h3>
            <p>{body}</p>
          </article>
        ))}
      </div>

    </section>

    <section class="closing" aria-labelledby="closing-title">
      <h2 id="closing-title">Put your API workflow where it belongs.</h2>
      <p>Install Noodle and open your first collection.</p>
      <InstallPill id="closing-install" command="curl -LsSf https://noodlerest.dev/install.sh | sh" />
      <a href="/docs/getting-started/quick-start/">Follow the quick start</a>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background:
      linear-gradient(color-mix(in srgb, var(--bg) 65%, transparent), color-mix(in srgb, var(--bg) 65%, transparent)),
      var(--bg) var(--page-pattern) top center / max(100vw, 960px) 1500px repeat-y;
  }

  #features {
    scroll-margin-top: 96px;
  }

  .landing {
    width: min(100%, 1200px);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .feature-row:first-child {
    border-top: 0;
  }

  .feature-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .feature-copy {
    min-width: 0;
    max-width: 30rem;
  }

  .section-kicker {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--coral);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capability-section h2,
  .closing h2 {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .feature-copy h2 {
    max-width: 24ch;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
  }

  :is(.feature-copy h2, .capability-grid h3) a {
    display: block;
    min-height: 44px;
    padding-block: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  :is(.feature-copy h2, .capability-grid h3) a:is(:hover, :focus-visible) {
    color: var(--accent);
  }

  :is(.feature-copy h2, .capability-grid h3) svg {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    margin-left: 0.5rem;
    color: var(--muted);
    vertical-align: -0.1em;
    transition: transform 0.2s, color 0.2s;
  }

  :is(.feature-copy h2, .capability-grid h3) a:is(:hover, :focus-visible) svg {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    :is(.feature-copy h2, .capability-grid h3) a:is(:hover, :focus-visible) svg {
      transform: translateX(4px);
    }
  }

  .feature-copy p,
  .capability-section header p,
  .closing > p {
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  .closing > a {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-underline-offset: 0.3em;
  }

  .feature-copy p {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }

  .code-proof,
  .exchange-proof,
  .environment-proof,
  .terminal-proof {
    min-width: 0;
    color: var(--muted);
    overflow: hidden;
    background: color-mix(in srgb, var(--panel) 45%, var(--bg));
    border: 1px solid var(--rule);
    border-radius: 16px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .proof-bar {
    padding: 1rem 1.25rem 0.5rem;
  }

  .code-proof pre {
    margin: 0;
    overflow-x: auto;
    padding: 0.5rem 1.25rem 1.25rem;
    background: transparent;
  }

  .code-proof code {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .syntax-violet { color: var(--violet); }
  .syntax-orange { color: var(--orange); }
  .syntax-cyan { color: var(--cyan); }
  .syntax-green { color: var(--green); }

  .response-toolbar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.75rem;
    align-items: center;
    min-height: 48px;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .response-toolbar code {
    min-width: 0;
    overflow-x: auto;
    color: var(--fg);
    font-size: inherit;
    white-space: nowrap;
  }

  .request-method {
    padding: 0.25rem 0.5rem;
    color: var(--ivory-ink);
    background: var(--orange);
    border-radius: 4px;
  }

  .response-status {
    color: var(--green);
  }

  .response-time {
    color: var(--muted);
  }

  .response-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 1.25rem 0;
  }

  .response-tabs span {
    padding-bottom: 0.375rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .response-tabs .is-active {
    color: var(--accent);
    box-shadow: inset 0 -2px var(--accent);
  }

  .response-tabs b {
    color: var(--fg);
    font-weight: 400;
  }

  .response-body {
    margin: 0;
    overflow-x: auto;
    padding: 0.75rem 1.25rem 1.25rem;
  }

  .response-body code {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .environment-proof {
    padding: 0.75rem 0;
  }

  .environment-proof > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 32px;
    padding: 0.375rem 1.25rem;
  }

  .environment-proof strong {
    display: flex;
    align-items: center;
    color: var(--fg);
    font-weight: 400;
  }

  .environment-proof > div > span:last-child {
    color: var(--green);
  }

  .dot {
    width: 6px;
    height: 6px;
    margin-right: 0.55rem;
    border-radius: 50%;
  }

  .dot-green { background: var(--green); }
  .dot-orange { background: var(--orange); }
  .dot-violet { background: var(--violet); }

  .environment-proof .secret-row {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .secret-row code {
    color: var(--violet);
  }

  .secret-row span:last-child {
    color: var(--fg) !important;
  }

  .terminal-proof {
    padding: 1.25rem;
  }

  .terminal-proof > div {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 0.5rem;
  }

  .terminal-proof > div > span {
    color: var(--green);
  }

  .terminal-proof code {
    min-width: 0;
    color: var(--fg);
    font-size: inherit;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .capability-section {
    padding-block: var(--section-space);
  }

  .capability-section header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .capability-section header h2 {
    max-width: 18ch;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    background: color-mix(in srgb, var(--panel) 86%, transparent);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .capability-grid article {
    position: relative;
    min-width: 0;
    padding: 1.5rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .capability-grid h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .capability-grid h3 a:focus-visible {
    outline: none;
  }

  .capability-grid h3 a:focus-visible::after {
    outline: 2px solid var(--color-blue);
    outline-offset: -3px;
  }

  .capability-grid article:nth-child(3n) {
    border-right: 0;
  }

  .capability-grid article:nth-last-child(-n + 3) {
    border-bottom: 0;
  }

  .capability-grid h3 {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .capability-grid p {
    margin-top: 0.55rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.55;
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    padding: var(--section-space) 0;
    text-align: center;
  }

  .closing h2 {
    max-width: 22ch;
  }

  .closing h2 {
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .closing :global(.install-block) {
    width: min(100%, 34rem);
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .feature-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .feature-copy {
      max-width: 42rem;
    }

    .capability-section header {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }
  }

  @media (max-width: 680px) {
    .landing {
      padding-inline: 1rem;
    }

    .feature-row {
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .capability-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .capability-grid article,
    .capability-grid article:nth-child(3n),
    .capability-grid article:nth-last-child(-n + 3) {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .capability-grid article:last-child {
      border-bottom: 0;
    }

  }
</style>
