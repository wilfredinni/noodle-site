---
import { logos } from "virtual:starlight/user-images"
import config from "virtual:starlight/user-config"
const { siteTitleHref } = Astro.locals.starlightRoute
---

<div class="site-title-group">
  <a href={siteTitleHref} class="site-title sl-flex">
    {
      config.logo && logos.dark && (
        <>
          <img
            class:list={{ "light:sl-hidden print:hidden": !("src" in config.logo) }}
            alt={config.logo.alt}
            src={logos.dark.src}
            width={logos.dark.width}
            height={logos.dark.height}
          />
          {!("src" in config.logo) && (
            <img
              class="dark:sl-hidden print:block"
              alt={config.logo.alt}
              src={logos.light?.src}
              width={logos.light?.width}
              height={logos.light?.height}
            />
          )}
        </>
      )
    }
    <span class:list={{ "sr-only": config.logo?.replacesTitle }} translate="no">noodle</span>
</a>

<div class="site-nav-links">
  <a href="/docs/">Docs</a>
  <a href="/compare/">Compare</a>
  <a href="/blog/">Blog</a>
</div>
</div>

<style>
  @layer starlight.core {
    .site-title-group {
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }
    .site-title {
      align-items: center;
      gap: 0.55rem;
      color: var(--sl-color-white);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    .site-title span {
      overflow: hidden;
      font-family: "Bodoni Moda", Georgia, serif;
      font-size: 1.65rem;
      font-weight: 400;
      line-height: 1;
    }
    .site-title img {
      width: 38px;
      height: 32px;
      object-fit: contain;
    }
    .site-nav-links {
      display: inline-flex;
      gap: 1rem;
      align-items: center;
    }
    .site-nav-links a {
      color: var(--sl-color-gray-2);
      text-decoration: none;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .site-nav-links a:hover {
      color: var(--sl-color-text);
    }

    @media (max-width: 64rem) {
      .site-title-group {
        gap: 0;
      }

      .site-nav-links {
        display: none;
      }
    }
  }
</style>
