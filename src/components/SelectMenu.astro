---
interface Props {
  label: string
  class?: string
  fitContent?: boolean
}
const { label, class: className, fitContent = false } = Astro.props
---

<div class:list={["select-control", className, { "fit-content": fitContent }]} data-select-menu>
  <slot name="trigger" />
  <div class="select-menu" popover="auto" role="menu" aria-label={label}>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-select-menu]").forEach((picker, index) => {
    const trigger = picker.querySelector<HTMLButtonElement>("[data-select-trigger]")!
    const menu = picker.querySelector<HTMLElement>("[popover]")!
    const options = [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')]
    let anchor: DOMRect | undefined
    menu.id = `select-menu-${index}`
    trigger.setAttribute("aria-controls", menu.id)
    trigger.setAttribute("popovertarget", menu.id)
    if (!("showPopover" in menu)) return
    trigger.disabled = false
    menu.addEventListener("toggle", () => {
      const open = menu.matches(":popover-open")
      trigger.setAttribute("aria-expanded", String(open))
      if (!open) return
      const rect = trigger.getBoundingClientRect()
      anchor = rect
      menu.style.maxHeight = ""
      const height = menu.offsetHeight
      const below = Math.max(0, innerHeight - rect.bottom - 16)
      const above = Math.max(0, rect.top - 16)
      const opensAbove = height > below && above > below
      menu.style.maxHeight = `${Math.min(height, opensAbove ? above : below)}px`
      menu.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - menu.offsetWidth - 8))}px`
      menu.style.top = `${Math.max(8, opensAbove ? rect.top - menu.offsetHeight - 8 : rect.bottom + 8)}px`
      const selected = options.find((option) => option.getAttribute("aria-checked") === "true") ?? options[0]!
      selected.focus({ preventScroll: true })
      menu.scrollTop = selected.offsetTop - (menu.clientHeight - selected.offsetHeight) / 2
    })
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault()
        menu.showPopover()
      }
    })
    options.forEach((option) => option.addEventListener("click", () => {
      menu.hidePopover()
      trigger.focus({ preventScroll: true })
    }))
    menu.addEventListener("keydown", (event) => {
      // Keep Escape from closing surrounding navigation as well as the popover.
      event.stopPropagation()
      if (event.key === "Tab") {
        menu.hidePopover()
        return
      }
      const index = options.indexOf(document.activeElement as HTMLButtonElement)
      let next = index
      if (event.key === "ArrowDown") next = (index + 1) % options.length
      else if (event.key === "ArrowUp") next = (index - 1 + options.length) % options.length
      else if (event.key === "Home") next = 0
      else if (event.key === "End") next = options.length - 1
      else if (event.key.length === 1 && /\S/.test(event.key) && !event.metaKey && !event.ctrlKey && !event.altKey) {
        next = options.findIndex((_, offset) => {
          const option = options[(index + offset + 1) % options.length]!
          return (option.dataset.selectSearch ?? option.textContent!).trim().toLowerCase().startsWith(event.key.toLowerCase())
        })
        if (next !== -1) next = (index + next + 1) % options.length
      } else return
      event.preventDefault()
      if (next !== -1) options[next]!.focus()
    })
    menu.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget) && event.relatedTarget !== trigger) menu.hidePopover()
    })
    window.addEventListener("resize", () => menu.hidePopover())
    document.addEventListener("scroll", (event) => {
      if (event.target === menu || !menu.matches(":popover-open")) return
      const rect = trigger.getBoundingClientRect()
      if (rect.top !== anchor?.top || rect.left !== anchor?.left) menu.hidePopover()
    }, true)
  })
</script>

<style>
  .select-control { display: inline-flex; max-width: 100%; }
  .select-control :global(button) { font: inherit; cursor: pointer; }
  .select-control :global(.select-trigger) { display: inline-flex; align-items: center; gap: 0.5rem; max-width: 100%; min-height: 44px; padding: 0 0.5rem; border: 0; border-radius: 8px; background: transparent; color: var(--muted); white-space: nowrap; }
  .select-control :global(.select-trigger:hover), .select-control :global(.select-trigger[aria-expanded="true"]) { background: var(--bg-elevated); color: var(--fg); }
  .select-control :global(.select-name) { min-width: 11ch; text-align: start; }
  .select-control :global(.select-chevron) { width: 12px; height: 12px; flex: none; }
  .select-control :global(.select-chevron), .select-menu :global(.select-check) { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .select-control :global(.select-trigger[aria-expanded="true"] .select-chevron) { transform: rotate(180deg); }
  .select-control :global(.select-trigger:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .select-control :global(.select-trigger:disabled) { cursor: default; }
  .select-menu { display: none; position: fixed; inset: auto; margin: 0; width: 252px; max-width: calc(100vw - 16px); max-height: calc(100dvh - 16px); box-sizing: border-box; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem; border: 1px solid var(--border-hover); border-radius: 8px; background: var(--bg-elevated); color: var(--fg); font: 400 0.875rem/1.5 var(--font-mono); scrollbar-color: var(--muted) var(--bg-elevated); scrollbar-width: thin; }
  .select-menu:popover-open { display: block; }
  .select-menu :global(button) { display: grid; grid-template-columns: 16px 1fr; align-items: center; gap: 0.5rem; width: 100%; min-height: 44px; padding: 0 0.5rem; border: 0; border-radius: 8px; background: transparent; color: var(--fg); text-align: start; white-space: nowrap; }
  .select-menu :global(button:hover), .select-menu :global(button:focus-visible) { background: var(--bg-card); }
  .select-menu :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  .select-menu :global(.select-check) { width: 16px; height: 16px; color: var(--accent); visibility: hidden; }
  .select-menu :global([aria-checked="true"] .select-check) { visibility: visible; }
  .fit-content .select-menu { width: max-content; max-height: min(28rem, calc(100dvh - 16px)); }
  .fit-content :global(.select-name) { min-width: 0; }
  .fit-content :global(.select-trigger), .fit-content .select-menu :global(button) { white-space: normal; }
</style>
