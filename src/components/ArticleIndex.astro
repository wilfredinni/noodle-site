---
import type { CollectionEntry } from "astro:content"

interface Props {
  kicker: string
  title: string
  description: string
  posts: CollectionEntry<"blog">[]
  emptyMessage?: string
  pagination?: {
    currentPage: number
    lastPage: number
    basePath: string
  }
}

const {
  kicker,
  title,
  description,
  posts,
  emptyMessage = "No articles found. Check back soon!",
  pagination,
} = Astro.props

const pageHref = (page: number) => page === 1
  ? `${pagination?.basePath}/`
  : `${pagination?.basePath}/page/${page}/`
---

<main class="article-index">
  <header class="index-header">
    <span class="index-kicker">{kicker}</span>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>

  {posts.length === 0 ? (
    <div class="empty-state">
      <p>{emptyMessage}</p>
    </div>
  ) : (
    <>
      <div class="article-list">
        {posts.map((post) => (
          <article class="article-row">
            <a href={`/blog/${post.id}/`}>
              <h2>{post.data.title}</h2>
              <div class="article-meta">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span>#{tag}</span>
                ))}
                <span class="article-arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      {pagination && pagination.lastPage > 1 && (
        <nav class="pagination" aria-label="Article pages">
          {pagination.currentPage > 1 ? (
            <a href={pageHref(pagination.currentPage - 1)}>← Previous</a>
          ) : <span></span>}
          <span>Page {pagination.currentPage} of {pagination.lastPage}</span>
          {pagination.currentPage < pagination.lastPage ? (
            <a href={pageHref(pagination.currentPage + 1)}>Next →</a>
          ) : <span></span>}
        </nav>
      )}
    </>
  )}
</main>

<style>
  :global(body:has(.article-index)) {
    background: var(--bg) url("data:image/svg+xml,%3Csvg viewBox='0 0 1600 1500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke-linecap='round'%3E%3Cpath d='M-180 310C260 20 470 610 910 420S1390 610 1780 190' stroke='%23f2c65a' stroke-width='28' opacity='.075'/%3E%3Cpath d='M1780 1080C1330 820 1160 1390 720 1190S210 910-180 1310' stroke='%2359c9be' stroke-width='20' opacity='.055'/%3E%3Cpath d='M-180 330C260 40 470 630 910 440S1390 630 1780 210' stroke='%23f3efe7' stroke-width='3' opacity='.035'/%3E%3C/g%3E%3C/svg%3E") top center / max(100vw, 960px) 1500px repeat-y;
  }

  .article-index {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 4vw, 2.5rem) 6rem;
  }

  .index-header {
    max-width: 760px;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .index-kicker {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--coral);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .index-header h1 {
    max-width: 10ch;
    margin: 0 0 1.25rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .index-header h1::after {
    display: block;
    width: min(4.5em, 100%);
    height: 8px;
    margin-top: 1.25rem;
    background: var(--noodle);
    content: "";
    transform: rotate(-1deg);
  }

  .index-header p {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .empty-state {
    padding: 6rem 2rem;
    color: var(--muted);
    text-align: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .article-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .article-row {
    border-bottom: 1px solid var(--border);
  }

  .article-row:first-child {
    border-top: 1px solid var(--border);
  }

  .article-row a {
    display: flex;
    align-items: center;
    min-height: 112px;
    gap: 2rem;
    padding: 1.5rem 0;
    color: inherit;
    text-decoration: none;
  }

  .article-row a:hover,
  .article-row a:focus-visible {
    outline: 2px solid transparent;
  }

  .article-row h2 {
    flex-grow: 1;
    margin: 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    transition: color 0.2s;
  }

  .article-row a:hover h2,
  .article-row a:focus-visible h2 {
    color: var(--accent);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }

  .article-meta span:not(.article-arrow) {
    color: var(--coral);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .article-arrow {
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 700;
    transition: transform 0.2s, color 0.2s;
  }

  .article-row a:hover .article-arrow,
  .article-row a:focus-visible .article-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 76px;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .pagination a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-decoration: none;
  }

  .pagination a:last-child {
    justify-self: end;
  }

  .pagination > span:nth-child(2) {
    text-align: center;
  }

  @media (max-width: 650px) {
    .article-row a {
      flex-direction: column;
      align-items: flex-start;
      min-height: 0;
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .article-meta {
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
    }
  }

  @media (max-width: 768px) {
    .article-index {
      padding: 4rem 1.25rem;
    }

    .pagination {
      gap: 0.5rem;
      font-size: 0.7rem;
    }
  }
</style>
