---
import { defaultSiteTheme, siteThemes } from "../lib/themes"
const defaultLabel = siteThemes.find(({ theme }) => theme.name === defaultSiteTheme)!.label
---

<div class="theme-picker">
  <button class="theme-trigger" data-theme-picker type="button" aria-label={`Change theme, ${defaultLabel} selected`} aria-haspopup="menu" aria-expanded="false" disabled>
    <svg class="theme-swatch" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="currentColor" /></svg>
    <span class="theme-name">{defaultLabel}</span>
    <svg class="theme-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </button>
  <div class="theme-menu" popover="auto" role="menu" aria-label="Site theme">
    {siteThemes.map(({ label, theme }) => (
      <button type="button" role="menuitemradio" aria-checked={theme.name === defaultSiteTheme ? "true" : "false"} data-theme-option={theme.name} tabindex="-1">
        <svg class="theme-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>
        <span>{label}</span>
        <svg class="theme-palette" viewBox="0 0 44 16" aria-hidden="true">
          <circle cx="6" cy="8" r="4" fill={theme.primary} />
          <circle cx="22" cy="8" r="4" fill={theme.secondary} />
          <circle cx="38" cy="8" r="4" fill={theme.accent} />
        </svg>
      </button>
    ))}
  </div>
</div>

<script>
  const defaultTheme = document.querySelector<HTMLElement>('[data-theme-option][aria-checked="true"]')!.dataset.themeOption!
  const pickers = [...document.querySelectorAll<HTMLElement>(".theme-picker")].map((picker, index) => {
    const trigger = picker.querySelector<HTMLButtonElement>("[data-theme-picker]")!
    const menu = picker.querySelector<HTMLElement>("[popover]")!
    menu.id = `site-theme-menu-${index}`
    trigger.setAttribute("aria-controls", menu.id)
    trigger.popoverTargetElement = menu
    return { trigger, menu, options: [...menu.querySelectorAll<HTMLButtonElement>("[data-theme-option]")] }
  })
  const update = (theme: string) => {
    document.documentElement.dataset.siteTheme = theme
    pickers.forEach(({ trigger, options }) => {
      const selected = options.find((option) => option.dataset.themeOption === theme)!
      const label = selected.querySelector("span")!.textContent!
      trigger.querySelector(".theme-name")!.textContent = label
      trigger.setAttribute("aria-label", `Change theme, ${label} selected`)
      options.forEach((option) => option.setAttribute("aria-checked", String(option === selected)))
    })
  }
  update(document.documentElement.dataset.siteTheme ?? defaultTheme)
  pickers.forEach(({ trigger, menu, options }) => {
    if (!("showPopover" in menu)) return
    trigger.disabled = false
    menu.addEventListener("toggle", () => {
      const open = menu.matches(":popover-open")
      trigger.setAttribute("aria-expanded", String(open))
      if (!open) return
      const rect = trigger.getBoundingClientRect()
      menu.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - menu.offsetWidth - 8))}px`
      menu.style.top = `${Math.max(8, Math.min(rect.bottom + 8, innerHeight - menu.offsetHeight - 8))}px`
      options.find((option) => option.getAttribute("aria-checked") === "true")!.focus({ preventScroll: true })
    })
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault()
        menu.showPopover()
      }
    })
    options.forEach((option) => option.addEventListener("click", () => {
      const theme = option.dataset.themeOption!
      update(theme)
      try { localStorage.setItem("noodle-site-theme", theme) } catch { /* Keep switching usable without storage. */ }
      menu.hidePopover()
      trigger.focus({ preventScroll: true })
    }))
    menu.addEventListener("keydown", (event) => {
      // Let Escape dismiss this popover without closing the surrounding mobile navigation.
      event.stopPropagation()
      if (event.key === "Tab") {
        menu.hidePopover()
        return
      }
      const index = options.indexOf(document.activeElement as HTMLButtonElement)
      let next = index
      if (event.key === "ArrowDown") next = (index + 1) % options.length
      else if (event.key === "ArrowUp") next = (index - 1 + options.length) % options.length
      else if (event.key === "Home") next = 0
      else if (event.key === "End") next = options.length - 1
      else if (event.key.length === 1 && /\S/.test(event.key) && !event.metaKey && !event.ctrlKey && !event.altKey) {
        next = options.findIndex((_, offset) => options[(index + offset + 1) % options.length].textContent!.trim().toLowerCase().startsWith(event.key.toLowerCase()))
        if (next !== -1) next = (index + next + 1) % options.length
      } else return
      event.preventDefault()
      if (next !== -1) options[next].focus()
    })
    menu.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget) && event.relatedTarget !== trigger) menu.hidePopover()
    })
    // A breakpoint or scroll can move the trigger; reopen at its new position.
    window.addEventListener("resize", () => menu.hidePopover())
    document.addEventListener("scroll", (event) => {
      if (event.target !== menu) menu.hidePopover()
    }, true)
  })
</script>

<style>
  .theme-picker { display: inline-flex; font: 400 0.875rem/1.5 var(--font-mono); }
  button { font: inherit; cursor: pointer; }
  .theme-trigger { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.5rem; border: 0; border-radius: 8px; background: transparent; color: var(--muted); white-space: nowrap; }
  .theme-trigger:hover, .theme-trigger[aria-expanded="true"] { background: var(--bg-elevated); color: var(--fg); }
  .theme-name { min-width: 11ch; text-align: start; }
  .theme-swatch { width: 16px; height: 16px; flex: none; color: var(--accent); }
  .theme-chevron { width: 12px; height: 12px; flex: none; }
  .theme-chevron, .theme-check { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .theme-trigger[aria-expanded="true"] .theme-chevron { transform: rotate(180deg); }
  .theme-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .theme-trigger:disabled { cursor: default; }
  .theme-menu { display: none; position: fixed; inset: auto; margin: 0; width: 252px; max-width: calc(100vw - 16px); max-height: calc(100dvh - 16px); box-sizing: border-box; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem; border: 1px solid var(--border-hover); border-radius: 8px; background: var(--bg-elevated); color: var(--fg); font: inherit; scrollbar-color: var(--muted) var(--bg-elevated); scrollbar-width: thin; }
  .theme-menu:popover-open { display: block; }
  .theme-menu button { display: grid; grid-template-columns: 16px 1fr 44px; align-items: center; gap: 0.5rem; width: 100%; min-height: 44px; padding: 0 0.5rem; border: 0; border-radius: 8px; background: transparent; color: var(--fg); text-align: start; white-space: nowrap; }
  .theme-menu button:hover, .theme-menu button:focus-visible { background: var(--bg-card); }
  .theme-menu button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .theme-check { width: 16px; height: 16px; color: var(--accent); visibility: hidden; }
  [aria-checked="true"] .theme-check { visibility: visible; }
  .theme-palette { width: 44px; height: 16px; }
</style>
