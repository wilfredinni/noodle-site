---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import productImage from "../../assets/landing.png"
import InstallPill from "../InstallPill.astro"

interface Props {
  latestRelease?: CollectionEntry<"blog">
}

const { latestRelease } = Astro.props
const latestReleaseLabel = latestRelease?.data.title
  .replace(/^Noodle\s+/, "v")
  .replace(":", " ·")
const [latestVersion, latestTitle] = (latestReleaseLabel ?? "").split(" · ")
---

<header class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true"></span> Open-source terminal REST client</p>
      <h1>API workflows,<br /><em>untangled.</em></h1>
    </div>

    <div class="hero-intro">
      {latestRelease && (
        <a class="latest-release" href={`/blog/${latestRelease.id}/`}>
          <span>{latestVersion}</span>
          <strong>{latestTitle}</strong>
          <span aria-hidden="true">→</span>
        </a>
      )}
      <p>
        Write, send, inspect, and automate HTTP requests from readable files without leaving your terminal.
        Keep every collection versioned beside the code it exercises, ready for the TUI, CLI, scripts, and coding agents.
      </p>
      <div class="install-card">
        <span>Install in one line</span>
        <InstallPill id="hero-install" command="curl -LsSf https://noodlerest.dev/install.sh | sh" />
      </div>
      <a href="/docs/getting-started/quick-start/">Explore the quick start <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <figure class="product-stage">
    <Image
      src={productImage}
      class="product-image"
      alt="Noodle terminal interface showing a request collection, request editor, and response inspector"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption><span>One collection</span><span>Readable files · live requests · inspectable responses</span><span>Any terminal</span></figcaption>
  </figure>

  <div class="value-strip" aria-label="Noodle product benefits">
    <article><h2>Fast by default</h2><p>Stay in the terminal and keep your hands on the keyboard.</p></article>
    <article><h2>Made to review</h2><p>Keep requests and environments readable beside your code.</p></article>
    <article><h2>Ready to automate</h2><p>Use the same collection from the TUI, CLI, scripts, and agents.</p></article>
  </div>
</header>

<style>
  .hero {
    width: min(100%, 1200px);
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 7rem) 1.5rem 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(27rem, 0.95fr);
    gap: clamp(3rem, 5vw, 4rem);
    align-items: start;
  }

  .latest-release {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 44px;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .latest-release > span:first-child {
    color: var(--noodle);
  }

  .latest-release strong {
    font-weight: 400;
  }

  .latest-release > span:last-child {
    color: var(--accent);
  }

  .eyebrow {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 2.5rem;
    height: 2px;
    background: var(--noodle);
  }

  h1 {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.82;
  }

  h1 em {
    position: relative;
    color: var(--accent);
    font-weight: 400;
  }

  h1 em::after {
    position: absolute;
    right: 0;
    bottom: 0.02em;
    left: 0.06em;
    height: 0.08em;
    background: var(--noodle);
    content: "";
    transform: rotate(-1.5deg);
  }

  .hero-intro {
    padding-bottom: 0.75rem;
  }

  .hero-intro > p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-intro > a {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .hero-intro > a span {
    color: var(--accent);
  }

  .install-card {
    margin-top: 1.5rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--panel) 86%, transparent);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .install-card > span {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--noodle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-stage {
    width: 100%;
    margin-top: clamp(3rem, 9vw, 8rem);
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
  }

  .product-image {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 48px;
    padding-inline: 1rem;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  figcaption span:first-child { color: var(--noodle); }
  figcaption span:last-child { justify-self: end; color: var(--accent); }

  .value-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--rule);
  }

  .value-strip article {
    min-width: 0;
    padding: 1.75rem 1.25rem;
    border-right: 1px solid var(--rule);
  }

  .value-strip article:last-child { border-right: 0; }

  .value-strip h2 {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1;
  }

  .value-strip h2::before {
    display: block;
    width: 1.5rem;
    height: 2px;
    margin-bottom: 0.75rem;
    background: var(--coral);
    content: "";
  }

  .value-strip p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .hero-intro {
      max-width: 36rem;
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding: 3rem 1rem 0;
    }

    figcaption {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    figcaption span:nth-child(2) {
      display: none;
    }

    .value-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .value-strip article {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .value-strip article:last-child {
      border-bottom: 0;
    }
  }
</style>
