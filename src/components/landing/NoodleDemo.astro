---
import { codeLines, formatSize, formatStatus, statusColorToken } from "./noodle-demo"
import { examples, folders, tourChapters, type Example } from "./noodle-demo-examples"
import SelectMenu from "../SelectMenu.astro"

interface Props {
  version?: string
}
const { version } = Astro.props

const optionalTabs = ["Assert", "Capture", "Pre Script", "Post Script", "Tests"]
const requestTabs = ["Headers", "Params", "Path", "Body", "Auth", ...optionalTabs, "Settings"]
const responseTabs = ["Body", "Headers", "Network", "Timeline", "Cookies", "Results"]
const scriptSource = (example: Example, tab: string) => tab === "Pre Script" ? example.scripts?.pre : tab === "Post Script" ? example.scripts?.post : tab === "Tests" ? example.tests : undefined
const hasContent = (example: Example, tab: string) => {
  if (tab === "Headers") return Object.keys(example.headers ?? {}).length > 0 || !!example.body
  if (tab === "Params") return !!example.params?.some((param) => param.enabled !== false)
  if (tab === "Path") return Object.keys(example.pathParams ?? {}).length > 0
  if (tab === "Body") return !!example.body || !!example.formData?.length
  if (tab === "Auth") return !!example.auth
  if (tab === "Capture") return !!example.captures?.length
  if (tab === "Settings") return !!example.tags?.length
  return tab === "Assert" ? !!example.assertions?.length : !!scriptSource(example, tab)
}
const tabSlug = (tab: string) => tab.replaceAll(" ", "-")
// Default settings shared by these read-only examples.
const requestSettings = [
  { label: "Timeout (ms)", value: "0ms", kind: "text", description: "Set maximum time to wait before aborting the request" },
  { label: "Follow Redirects", value: "true", kind: "check", description: "Automatically follow HTTP redirects" },
  { label: "Max Redirects", value: "5", kind: "text", description: "Maximum number of redirects to follow" },
  { label: "TLS Verification", value: "Inherit (verify)", kind: "select", description: "Verify the server certificate, or inherit the collection setting" },
  { label: "Send Cookies", value: "true", kind: "check", description: "Send cookies from the collection cookie jar" },
]
// Default shortcuts from Noodle's keybindingHints and StatusBar. Only local demo actions are enabled.
const expand = ["f2", "expand", "expand"]
const commands = ["^p", "commands"]
const footerHints: Record<string, string[][]> = {
  sidebar: [["^n", "new"], ["^alt+n", "new folder"], ["^k", "clone"], ["^w", "delete"], ["^s", "save"]],
  urlbar: [["^s", "save"]],
  "request-base": [expand, ["^s", "save"], commands],
  "request-fields": [expand, ["Space", "toggle"], ["^d", "revert"], ["^s", "save"], ["^r", "revert all"], commands],
  "request-path": [expand, ["^d", "revert"], ["^r", "revert all"], ["^s", "save"], commands],
  "request-assert": [expand, ["Space", "toggle"], ["^d", "delete"], ["^s", "save"], ["^r", "revert all"], commands],
  "request-body": [expand, ["^g", "fold"], commands],
  "request-script": [expand, commands],
  "response-body": [expand, ["m", "visual"], ["^g", "fold"], ["/", "filter"], ["^alt+b", "copy", "copy"], commands],
  "response-cookies": [expand, ["↑/↓", "select"], ["Enter", "details"], commands],
  "response-base": [expand, commands],
}
---

<figure class="noodle-demo" data-noodle-demo aria-label="Interactive Noodle demo with sample responses">
  <div class="terminal">
    <div class="tour-progress" aria-hidden="true"><span data-tour-progress></span></div>
    <div class="terminal-title">
      <div class="terminal-identity">
        <span class="terminal-brand"><strong>Noodle</strong>{version && <span class="terminal-version"> {version}</span>}</span>
        <div class="collection-label">
          <span class="title-divider">/</span>
          <SelectMenu class="tour-picker" label="Tour chapter" fitContent>
            <button slot="trigger" type="button" class="select-trigger tour-title-trigger" data-select-trigger data-tour-select aria-label={`Tour chapter, 1 / ${tourChapters.length} · ${tourChapters[0]!.title} selected`} aria-haspopup="menu" aria-expanded="false" disabled>
              <span class="select-name" data-tour-title>{tourChapters[0]!.title}</span>
              <svg class="select-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
            </button>
            {tourChapters.map((chapter, index) => {
              const example = examples.find((example) => example.id === chapter.request)!
              return <button type="button" role="menuitemradio" aria-checked={index === 0 ? "true" : "false"} data-tour-option={chapter.request} data-select-search={chapter.title} data-title={chapter.title} data-description={chapter.description} data-response-tab={chapter.responseTab ?? "Body"} data-duration={example.scripts || example.tests ? 16000 : 12000} tabindex="-1">
                <svg class="select-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3 3 7-7" /></svg>
                <span>{index + 1} / {tourChapters.length} · {chapter.title}</span>
              </button>
            })}
          </SelectMenu>
        </div>
      </div>
      <div class="terminal-actions">
        <span class="environment"><svg viewBox="0 0 16 16" aria-hidden="true"><ellipse cx="8" cy="4" rx="5" ry="2" /><path d="M3 4v7c0 2.7 10 2.7 10 0V4M3 7.5c0 2.7 10 2.7 10 0" /></svg>development</span>
        <div class="tour-controls tour-buttons" role="group" aria-label="Guided tour controls">
          <button type="button" data-tour-previous aria-label="Previous chapter" title="Previous chapter" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <button type="button" data-tour-play aria-label="Play tour" title="Play tour" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7z" /></svg>
          </button>
          <button type="button" data-tour-next aria-label="Next chapter" title="Next chapter" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="terminal-layout">
      <section class="collection pane" aria-label="Example requests" tabindex="-1">
        <h2 class="pane-title">Requests</h2>
        <div class="request-tree">
          {folders.map((folder) => (
            <details class="request-folder" open={folder === examples[0]!.folder}>
              <summary class="folder-name"><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg>{folder}</summary>
              {examples.filter((example) => example.folder === folder).map((example) => (
                <button type="button" class="request-choice" title={example.name} data-request={example.id} aria-pressed={example.id === "create" ? "true" : "false"} aria-controls={`demo-${example.id}`} disabled>
                  <span class:list={["method", example.method.toLowerCase()]}>{example.method === "DELETE" ? "DEL" : example.method}</span><span>{example.name}</span>
                </button>
              ))}
            </details>
          ))}
        </div>
      </section>

      {examples.map((example, index) => {
        const response = JSON.stringify(example.response, null, 2)
        const bytes = new TextEncoder().encode(response).length
        const query = new URLSearchParams((example.params ?? []).filter((param) => param.enabled !== false).map(({ name, value }) => [name, value])).toString()
        const url = `${example.baseUrl ?? "https://jsonplaceholder.typicode.com"}${example.path.replace(/:(\w+)/g, (match, key) => example.pathParams?.[key] ?? match)}${query ? `?${query}` : ""}`
        const groups = [
          { name: "Request", tabs: requestTabs, initial: example.tab },
          { name: "Response", tabs: responseTabs, initial: "Body" },
        ]
        return (
          <div class="workspace" id={`demo-${example.id}`} data-example={example.id} data-name={example.name} data-status={example.status} style={`--demo-status: var(--demo-${statusColorToken(Number.parseInt(example.status, 10))})`} hidden={index !== 0}>
            <div class="url-bar">
              <span class:list={["method", "method-badge", example.method.toLowerCase()]}>{example.method}<svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg></span>
              <code tabindex="0" aria-label="Request URL"><span class:list={{ variable: !example.baseUrl }}>{example.baseUrl ?? "$base_url"}</span>{example.path.split(/(:\w+|\$\w+)/).map((part) => /^[\$:]/.test(part) ? <span class="variable">{part}</span> : part)}</code>
              <button class="send" type="button" data-send disabled><span>Send</span></button>
            </div>
            {groups.map((group) => (
              <section class:list={["pane", "detail-pane", group.name.toLowerCase()]} data-group={group.name} data-default-tab={group.initial} aria-label={group.name}>
                <div class="pane-heading">
                  <h2 class="pane-title">{group.name}</h2>
                  {group.name === "Response" && (
                    <div class="response-summary"><span class="response-metrics">{formatSize(bytes)} in {Math.round(example.duration)}ms</span><strong class="response-status" title={example.status}>{formatStatus(example.status)}</strong></div>
                  )}
                </div>
                <div class="tab-bar">
                  <div class="tabs" role="tablist" aria-label={`${group.name} views`}>
                    {group.tabs.map((tab) => (
                      <button type="button" role="tab" id={`demo-${example.id}-${group.name}-${tabSlug(tab)}-tab`} aria-controls={`demo-${example.id}-${group.name}-${tabSlug(tab)}`} aria-selected={tab === group.initial ? "true" : "false"} tabindex={tab === group.initial ? 0 : -1} data-tab={tab} class:list={{ "has-content": group.name === "Request" && hasContent(example, tab), "has-results": tab === "Results" && !!(example.assertions || example.captures || example.scripts || example.tests) }} hidden={group.name === "Request" && optionalTabs.includes(tab) && !hasContent(example, tab)} disabled>{tab}</button>
                    ))}
                  </div>
                  {group.name === "Request" && (
                    <div class="optional-tabs">
                      <button type="button" class="add-tab" data-add-tab aria-label="Add request tab" aria-haspopup="menu" aria-expanded="false" aria-controls={`demo-${example.id}-tab-menu`} disabled><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg></button>
                      <div class="tab-menu" id={`demo-${example.id}-tab-menu`} role="menu" aria-label="Optional request tabs" data-tab-menu hidden>
                        {optionalTabs.map((tab) => <button type="button" role="menuitem" tabindex="-1" data-reveal-tab={tab} disabled={hasContent(example, tab)}>{tab}</button>)}
                      </div>
                    </div>
                  )}
                </div>
                <div class="panels">
                  <p class="sending-message" hidden>Sending sample request…</p>
                  {group.tabs.map((tab) => {
                    const panelCode = tab === "Body" ? group.name === "Request" ? example.body : response : ""
                    const externalScript = tab === "Tests" ? undefined : example.scriptFiles?.[tab === "Pre Script" ? "pre" : "post"]
                    const requestFields = group.name === "Request" && ["Headers", "Params", "Path"].includes(tab)
                    const showToggle = requestFields && tab !== "Path"
                    const rows = tab === "Headers" ? group.name === "Response" ? [["content-type", "application/json; charset=utf-8"], ["cache-control", "no-cache"]] : Object.entries(example.headers ?? (example.body ? { "Content-Type": "application/json", Accept: "application/json" } : {})) : tab === "Path" ? Object.entries(example.pathParams ?? {}) : tab === "Params" ? (example.params ?? []).map((param) => [param.name, param.value, param.enabled === false ? "disabled" : ""]) : []
                    return (
                      <div class="tab-panel" role="tabpanel" id={`demo-${example.id}-${group.name}-${tabSlug(tab)}`} aria-labelledby={`demo-${example.id}-${group.name}-${tabSlug(tab)}-tab`} tabindex="0" hidden={tab !== group.initial}>
                        {tab === "Body" && (
                          <>
                            {group.name === "Request" && <div class="body-format"><select class="demo-select" aria-label="Request body format" disabled><option>{example.bodyFormat ?? (example.body ? "JSON" : "None")}</option></select></div>}
                            {group.name === "Request" && example.formData ? (
                              <table class="field-table" style="--field-toggle: 4ch" aria-label="Request form data">
                                <colgroup><col class="field-enabled" /><col class="field-key" /><col /></colgroup>
                                <thead class="sr-only"><tr><th>Enabled</th><th>Name</th><th>Value</th></tr></thead>
                                <tbody>{example.formData.map((field) => <tr><td class="field-enabled"><span class="checked-value" aria-hidden="true">[x]</span><span class="sr-only">Enabled</span></td><th scope="row">{field.type === "file" ? "[F] " : ""}{field.name}</th><td title={field.value}>{field.value}</td></tr>)}</tbody>
                              </table>
                            ) : group.name === "Request" && example.bodyFormat === "Binary" ? <p class="binary-path" aria-label="Binary file path">{example.body}</p> : panelCode ? <pre aria-label={`${group.name} body`}><code>{codeLines(panelCode, example.bodyFormat === "XML" && group.name === "Request" ? "xml" : "json").map((line) => (
                              <span class="code-line">{line.map((token) => <span class={token.kind}>{token.text}</span>)}</span>
                            ))}</code></pre> : <p class="native-empty">This {example.method} request has no body.</p>}
                          </>
                        )}
                        {["Headers", "Params", "Path"].includes(tab) && (rows.length ? (
                          <table class={requestFields ? "field-table" : "key-value-table"} style={requestFields ? `--field-toggle: ${showToggle ? 4 : 0}ch` : `--header-width: ${Math.max(...rows.map(([key]) => key.length)) + 2}ch`} aria-label={`${group.name} ${tab.toLowerCase()}`}>
                            {requestFields && <colgroup>{showToggle && <col class="field-enabled" />}<col class="field-key" /><col /></colgroup>}
                            <thead class="sr-only"><tr>{showToggle && <th>Enabled</th>}<th>Key</th><th>Value</th></tr></thead>
                            <tbody>{rows.map(([key, value, disabled]) => <tr class:list={{ "disabled-param": disabled }}>{showToggle && <td class="field-enabled"><span class="checked-value" aria-hidden="true">{disabled ? "[ ]" : "[x]"}</span><span class="sr-only">{disabled ? "Disabled" : "Enabled"}</span></td>}<th scope="row" title={key}>{key}</th><td title={value}><span class:list={{ variable: requestFields && value.startsWith("$") }}>{value}</span></td></tr>)}</tbody>
                          </table>
                        ) : <p class="empty-state">{tab === "Headers" ? "No request headers." : tab === "Params" ? "No query parameters." : "No path parameters."}</p>)}
                        {tab === "Assert" && (example.assertions?.length ? (
                          <table class="assertions" aria-label="Response assertions"><colgroup><col class="assert-enabled" /><col class="assert-expression" /><col class="assert-operator" /><col /></colgroup><thead class="sr-only"><tr><th>Enabled</th><th>Expression</th><th>Operator</th><th>Expected</th></tr></thead><tbody>{example.assertions.map((assertion) => <tr><td><span class="checked-value" aria-hidden="true">[x]</span><span class="sr-only">Enabled</span></td><th scope="row" title={assertion.expression}>{assertion.expression}</th><td><select class="demo-select" aria-label={`${assertion.expression} operator`} disabled><option>{assertion.operator}</option></select></td><td title={String(assertion.value ?? "")}>{assertion.value ?? ""}</td></tr>)}</tbody></table>
                        ) : <p class="native-empty">No response assertions.</p>)}
                        {tab === "Capture" && (example.captures?.length ? (
                          <table class="captures" aria-label="Response captures">
                            <colgroup><col class="assert-enabled" /><col class="capture-variable" /><col /><col class="capture-persistence" /></colgroup>
                            <thead class="sr-only"><tr><th>Enabled</th><th>Variable</th><th>Expression</th><th>Persistence</th></tr></thead>
                            <tbody>{example.captures.map((capture) => (
                              <tr>
                                <td><span class="checked-value" aria-hidden="true">[x]</span><span class="sr-only">Enabled</span></td>
                                <th scope="row" title={capture.variable}>{capture.variable}</th>
                                <td title={capture.expression}>{capture.expression}</td>
                                <td><select class="demo-select" aria-label={`${capture.variable} persistence`} disabled><option value="transient" selected={!capture.persist}>Run only</option><option value="secret" selected={capture.persist === "secret"}>Secret</option><option value="environment" selected={capture.persist === "environment"}>Environment</option></select></td>
                              </tr>
                            ))}</tbody>
                          </table>
                        ) : <p class="native-empty">No response captures.</p>)}
                        {["Pre Script", "Post Script", "Tests"].includes(tab) && (
                          <>
                            <div class="script-format"><select class="demo-select" aria-label={`${tab} source`} disabled><option>{externalScript ? "External file" : "Inline"}</option></select><p class="setting-description">Write inline or use a .js file.</p></div>
                            {externalScript ? <div class="external-script"><div class="setting-value"><span>File:</span><span>{externalScript}</span></div><p class="setting-description">Relative to the collection root.</p></div> : scriptSource(example, tab) ? <pre class="script-code" aria-label={tab}><code>{codeLines(scriptSource(example, tab)!, "javascript").map((line) => <span class="code-line">{line.map((token) => <span class={token.kind}>{token.text}</span>)}</span>)}</code></pre> : <p class="native-empty">{tab === "Tests" ? "No scripted tests." : `No ${tab === "Pre Script" ? "pre-request" : "post-response"} script.`}</p>}
                          </>
                        )}
                        {tab === "Auth" && (
                          <div class="native-panel auth-panel">
                            <select class="demo-select" aria-label="Authentication type" disabled><option>{example.auth?.type ?? "None"}</option></select>
                            {Object.entries(example.auth?.fields ?? {}).map(([label, { value, description, kind, required }]) => (
                              <div class="setting-row">
                                <div class="setting-value">
                                  {kind === "check" ? <><span class="checked-value" aria-hidden="true">{value === "true" ? "[x]" : "[ ]"}</span><span class="sr-only">{value === "true" ? "Enabled" : "Disabled"}</span><span>{label}</span></> : <><span>{label}{required && "*"}:</span>{kind === "select" ? <select class="demo-select auth-field-select" aria-label={label} disabled><option>{value}</option></select> : <span class:list={{ variable: value.startsWith("$") }}>{value}</span>}</>}
                                </div>
                                {description && <p class="setting-description">{description}</p>}
                              </div>
                            ))}
                          </div>
                        )}
                        {tab === "Settings" && (
                          <div class="native-panel">
                            <div class="setting-value"><span>Tags:</span>{example.tags?.map((tag) => <span class="tag-placeholder tag-value">#{tag}</span>)}<button class="tag-placeholder" type="button" disabled>+ Add tag</button></div>
                            {requestSettings.map((setting) => (
                              <div class="setting-row">
                                <div class="setting-value">
                                  <span>{setting.label}:</span>
                                  {setting.kind === "select" ? (
                                    <select class="demo-select fit-content" aria-label={setting.label} disabled><option>{setting.value}</option></select>
                                  ) : setting.kind === "check" ? (
                                    <span><span class="checked-value" aria-hidden="true">[x]</span><span class="sr-only">Enabled</span></span>
                                  ) : <span>{setting.value}</span>}
                                </div>
                                <p class="setting-description">{setting.description}</p>
                              </div>
                            ))}
                          </div>
                        )}
                        {tab === "Network" && (
                          <>
                            <p class="network-note">Illustrative network timings</p>
                            <ol class="network-log">
                              <li><span>0ms</span><code>{example.method} {url}</code></li>
                              <li><span>{example.duration}ms</span><code>{example.status}</code></li>
                              <li><span>{example.duration}ms</span><code>Body received · {bytes} bytes</code></li>
                              <li><span>{example.duration}ms</span><code>Completed in {example.duration}ms</code></li>
                            </ol>
                          </>
                        )}
                        {tab === "Timeline" && (
                          <div class="native-panel">
                            <div class="timeline-row">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3v7H3m3-3-3 3 3 3" /></svg>
                                <span class:list={["method", example.method.toLowerCase()]}>{example.method === "DELETE" ? "DEL" : example.method}</span>
                                <span class="timeline-status">{example.status.slice(0, 3)}</span>
                                <span class="timeline-url">{url}</span>
                                <span class="timeline-timing">{example.duration}ms <span>sample</span></span>
                            </div>
                          </div>
                        )}
                        {tab === "Cookies" && (example.cookies?.length ? (
                          <div class="cookie-rows disclosure-rows" aria-label="Response cookies" style={`--result-name-width: ${Math.min(24, Math.max(...example.cookies.map((cookie) => cookie.name.length)) + 2)}ch; --result-value-width: 0ch`}>
                            {example.cookies.map((cookie) => <details class="result-entry" name={`demo-${example.id}-cookies`}><summary><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg><span class="cookie-received">RECEIVED</span><span class="result-name">{cookie.name}</span><span class="result-meta">{cookie.value}</span></summary><dl><dt>Value</dt><dd>{cookie.value}</dd><dt>Domain</dt><dd>{cookie.domain}</dd><dt>Path</dt><dd>{cookie.path}</dd><dt>Expires</dt><dd>session</dd></dl></details>)}
                          </div>
                        ) : <p class="native-empty">No cookies captured.</p>)}
                        {tab === "Results" && (example.assertions || example.captures || example.scripts || example.tests ? (
                          <div class="sample-results disclosure-rows" style={`--result-name-width: ${example.assertions ? Math.max(...example.assertions.map((item) => item.expression.length + 1)) : example.captures ? Math.min(24, Math.max(...example.captures.map((item) => item.variable.length + 2))) : example.testNames ? Math.max(...example.testNames.map((name) => name.length + 1)) : example.scripts?.post ? 14 : 12}ch; --result-value-width: ${example.assertions ? Math.max(...example.assertions.map((item) => item.operator.length)) + 1 : example.tests ? 4 : 0}ch`}>
                            <p class="sr-only">Sample results</p>
                            {example.scripts && <>
                              <h3><strong>Scripts</strong> <span>Passed</span></h3>
                              {Object.keys(example.scripts).map((phase) => <details class="result-entry" name={`demo-${example.id}-results`}><summary><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg><span class="result-pass">PASS</span><span class="result-name">{phase === "pre" ? "Pre-request" : "Post-response"}</span><span class="result-meta">2ms, 0 logs</span></summary><dl><dt>Phase</dt><dd>{phase}</dd><dt>Scope</dt><dd>request</dd><dt>Kind</dt><dd>{example.scriptFiles?.[phase as "pre" | "post"] ? "external" : "inline"}</dd><dt>Source</dt><dd>{example.scriptFiles?.[phase as "pre" | "post"] ?? "inline"}</dd><dt>Duration</dt><dd>2ms (sample)</dd></dl></details>)}
                            </>}
                            {example.captures && <>
                              <h3><strong>Captures</strong> <span>{example.captures.length} captured · 0 failed</span></h3>
                              {example.captures.map((capture) => <details class="result-entry" name={`demo-${example.id}-results`}><summary><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg><span class="result-pass">CAPTURED</span><span class="result-name">{capture.variable}</span><span class="result-meta">{capture.expression}</span></summary><dl><dt>Expression</dt><dd>{capture.expression}</dd><dt>Value</dt><dd>{capture.value}</dd><dt>Scope</dt><dd>Current run</dd>{capture.persist && <><dt>Persisted</dt><dd>{capture.persist}</dd></>}</dl></details>)}
                            </>}
                            {example.assertions && <>
                              <h3><strong>Assertions</strong> <span>{example.assertions.length} passed · 0 failed</span></h3>
                              {example.assertions.map((assertion) => <details class="result-entry" name={`demo-${example.id}-results`}><summary><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg><span class="result-pass">PASS</span><span class="result-name">{assertion.expression}</span><span class="result-meta"> {assertion.operator}</span></summary><dl>{assertion.value !== undefined && <><dt>Expected</dt><dd>{assertion.value}</dd></>}<dt>Actual</dt><dd>{assertion.actual}</dd></dl></details>)}
                            </>}
                            {example.tests && <>
                              <h3><strong>Scripted tests</strong> <span>{example.testNames!.length} passed · 0 failed</span></h3>
                              {example.testNames!.map((name) => <details class="result-entry" name={`demo-${example.id}-results`}><summary><svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0h10L5 6z" /></svg><span class="result-pass">PASS</span><span class="result-name">{name}</span><span class="result-meta"> 1ms</span></summary><dl><dt>Name</dt><dd>{name}</dd><dt>Message</dt><dd>Passed (sample)</dd><dt>Duration</dt><dd>1ms (sample)</dd></dl></details>)}
                            </>}
                          </div>
                        ) : <p class="native-empty">No execution results.</p>)}
                      </div>
                    )
                  })}
                </div>
              </section>
            ))}
          </div>
        )
      })}
    </div>
    <div class="terminal-foot" aria-label="Noodle keyboard shortcuts" aria-describedby="noodle-demo-shortcuts">
      {Object.entries(footerHints).map(([context, hints]) => (
        <div class="footer-context" data-footer-context={context} tabindex="0" aria-label="Contextual app shortcuts" hidden={context !== "sidebar"}>
          {hints.map(([key, label, action]) => (
            <button type="button" data-footer-action={action} disabled title={action ? undefined : "Available in Noodle; not simulated in this read-only demo"}>
              <kbd>{key}</kbd><span>{label}</span>
            </button>
          ))}
        </div>
      ))}
      <button type="button" class="footer-send" data-footer-send disabled><kbd>^return</kbd><span>send</span></button>
    </div>
  </div>
  <p class="sr-only" id="noodle-demo-shortcuts">Shortcuts from the Noodle app. Expand, copy, and send work in this demo. Other commands are shown for reference and disabled.</p>
  <p class="sr-only" role="status" data-demo-status></p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-noodle-demo]").forEach((demo) => {
    const choices = [...demo.querySelectorAll<HTMLButtonElement>("[data-request]")]
    const examples = [...demo.querySelectorAll<HTMLElement>("[data-example]")]
    const panes = [...demo.querySelectorAll<HTMLElement>(".pane")]
    const status = demo.querySelector<HTMLElement>("[data-demo-status]")!
    const footerSend = demo.querySelector<HTMLButtonElement>("[data-footer-send]")!
    let active = examples[0]!
    let pending: ReturnType<typeof setTimeout> | undefined
    let focusedGroup: HTMLElement | null = null

    const activatePane = (target: HTMLElement) => {
      if (target.closest(".terminal-foot")) return
      const group = target.closest<HTMLElement>("[data-group]")
      const tab = group?.querySelector<HTMLElement>('[aria-selected="true"]')?.dataset.tab
      const inPanel = !!target.closest("[role=tabpanel]")
      let context: string
      if (target.closest(".collection")) context = "sidebar"
      else if (target.closest(".url-bar")) context = "urlbar"
      else if (group?.dataset.group === "Request") {
        context = inPanel && ["Headers", "Params"].includes(tab!) ? "request-fields"
          : inPanel && tab === "Path" ? "request-path"
          : inPanel && ["Assert", "Capture"].includes(tab!) ? "request-assert"
          : inPanel && ["Pre Script", "Post Script", "Tests"].includes(tab!) ? "request-script"
          : inPanel && tab === "Body" && group.querySelector("pre") ? "request-body" : "request-base"
      } else if (group?.dataset.group === "Response") {
        context = tab === "Body" ? "response-body" : tab === "Cookies" ? "response-cookies" : "response-base"
      } else return
      const selectedPane = target.closest<HTMLElement>(".pane")
      if (selectedPane) panes.forEach((pane) => pane.classList.toggle("is-active", pane === selectedPane))
      focusedGroup = group
      demo.querySelectorAll<HTMLElement>("[data-footer-context]").forEach((hints) => {
        hints.hidden = hints.dataset.footerContext !== context
      })
    }
    demo.addEventListener("focusin", (event) => activatePane(event.target as HTMLElement))
    demo.addEventListener("click", (event) => activatePane(event.target as HTMLElement))

    const toggleExpanded = () => {
      if (!focusedGroup) return
      pauseTour()
      const expanded = focusedGroup.classList.toggle("is-expanded")
      active.classList.toggle("is-expanded", expanded)
      demo.querySelectorAll<HTMLElement>('[data-footer-action="expand"] span').forEach((label) => {
        label.textContent = expanded ? "collapse" : "expand"
      })
    }
    const copyBody = async () => {
      if (pending !== undefined) return
      const name = active.dataset.name
      try {
        await navigator.clipboard.writeText(active.querySelector('[aria-label="Response body"] code')!.textContent!)
        status.textContent = `${name} sample response copied.`
      } catch {
        status.textContent = "Copy unavailable. Select and copy the response text."
      }
    }
    demo.querySelectorAll<HTMLButtonElement>("[data-footer-action]").forEach((button) => {
      button.addEventListener("click", () => button.dataset.footerAction === "expand" ? toggleExpanded() : void copyBody())
    })
    demo.addEventListener("keydown", (event) => {
      if (!(event.target as HTMLElement).closest(".terminal")) return
      const summary = (event.target as HTMLElement).closest(".disclosure-rows summary")
      if (summary && !event.ctrlKey && !event.altKey && !event.metaKey && ["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
        const rows = [...summary.closest(".disclosure-rows")!.querySelectorAll<HTMLElement>("summary")]
        const index = rows.indexOf(summary as HTMLElement)
        const next = event.key === "Home" ? 0 : event.key === "End" ? rows.length - 1 : Math.max(0, Math.min(rows.length - 1, index + (event.key === "ArrowDown" ? 1 : -1)))
        event.preventDefault()
        rows[next]!.focus()
      } else if (event.ctrlKey && event.key === "Enter") {
        event.preventDefault()
        footerSend.click()
      } else if (event.key === "F2" && focusedGroup) {
        event.preventDefault()
        toggleExpanded()
      } else if (event.ctrlKey && event.altKey && event.code === "KeyB" && focusedGroup?.dataset.group === "Response" && focusedGroup.querySelector('[data-tab="Body"]')?.getAttribute("aria-selected") === "true" && pending === undefined) {
        event.preventDefault()
        void copyBody()
      }
    })

    const selectTab = (group: HTMLElement, selected: HTMLButtonElement) => {
      group.querySelectorAll<HTMLButtonElement>("[role=tab]").forEach((tab) => {
        tab.setAttribute("aria-selected", String(tab === selected))
        tab.tabIndex = tab === selected ? 0 : -1
      })
      group.querySelectorAll<HTMLElement>("[role=tabpanel]").forEach((panel) => {
        panel.hidden = panel.id !== selected.getAttribute("aria-controls")
      })
      const list = selected.parentElement!
      if (selected.offsetLeft < list.scrollLeft) list.scrollLeft = selected.offsetLeft
      else if (selected.offsetLeft + selected.offsetWidth > list.scrollLeft + list.clientWidth) {
        list.scrollLeft = selected.offsetLeft + selected.offsetWidth - list.clientWidth
      }
      activatePane(selected)
    }

    const setSending = (sending: boolean) => {
      const button = active.querySelector<HTMLButtonElement>("[data-send]")!
      button.setAttribute("aria-disabled", String(sending))
      button.querySelector("span")!.textContent = sending ? "Sending…" : "Send"
      footerSend.setAttribute("aria-disabled", String(sending))
      footerSend.querySelector("span")!.textContent = sending ? "sending…" : "send"
      const response = active.querySelector<HTMLElement>(".response")!
      response.setAttribute("aria-busy", String(sending))
      response.querySelector<HTMLElement>(".sending-message")!.hidden = !sending
      demo.querySelector('[data-footer-action="copy"]')!.setAttribute("aria-disabled", String(sending))
    }

    const selectRequest = (choice: HTMLButtonElement) => {
      clearTimeout(pending)
      pending = undefined
      setSending(false)
      if (active.classList.contains("is-expanded")) {
        active.classList.remove("is-expanded")
        active.querySelector(".detail-pane.is-expanded")?.classList.remove("is-expanded")
        demo.querySelectorAll<HTMLElement>('[data-footer-action="expand"] span').forEach((label) => { label.textContent = "expand" })
      }
      active = examples.find((example) => example.dataset.example === choice.dataset.request)!
      examples.forEach((example) => { example.hidden = example !== active })
      choices.forEach((button) => button.setAttribute("aria-pressed", String(button === choice)))
      active.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
        selectTab(group, group.querySelector<HTMLButtonElement>(`[data-tab="${group.dataset.defaultTab}"]`)!)
      })
      status.textContent = `${active.dataset.name}. Sample response: ${active.dataset.status}.`
      activatePane(choice)
    }

    demo.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      const tabs = [...group.querySelectorAll<HTMLButtonElement>("[role=tab]")]
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => { pauseTour(); selectTab(group, tab) })
        tab.addEventListener("keydown", (event) => {
          const visibleTabs = tabs.filter((tab) => !tab.hidden)
          const index = visibleTabs.indexOf(tab)
          let next: number
          if (event.key === "ArrowRight") next = (index + 1) % visibleTabs.length
          else if (event.key === "ArrowLeft") next = (index - 1 + visibleTabs.length) % visibleTabs.length
          else if (event.key === "Home") next = 0
          else if (event.key === "End") next = visibleTabs.length - 1
          else return
          event.preventDefault()
          pauseTour()
          selectTab(group, visibleTabs[next]!)
          visibleTabs[next]!.focus()
        })
      })
      const add = group.querySelector<HTMLButtonElement>("[data-add-tab]")
      if (!add) return
      const menu = group.querySelector<HTMLElement>("[data-tab-menu]")!
      const items = [...menu.querySelectorAll<HTMLButtonElement>("[data-reveal-tab]")]
      const closeMenu = (returnFocus = false) => {
        menu.hidden = true
        add.setAttribute("aria-expanded", "false")
        if (returnFocus) add.focus()
      }
      const openMenu = (last = false) => {
        pauseTour()
        menu.hidden = false
        add.setAttribute("aria-expanded", "true")
        const available = items.filter((item) => !item.disabled)
        ;(last ? available.at(-1) : available[0])?.focus()
      }
      add.addEventListener("click", () => menu.hidden ? openMenu() : closeMenu())
      add.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault()
          openMenu(event.key === "ArrowUp")
        } else if (event.key === "Escape") closeMenu(true)
      })
      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape" || event.key === "Tab") {
          if (event.key === "Escape") event.preventDefault()
          closeMenu(true)
          return
        }
        const available = items.filter((item) => !item.disabled)
        const index = available.indexOf(document.activeElement as HTMLButtonElement)
        let next: number
        if (event.key === "ArrowDown") next = (index + 1) % available.length
        else if (event.key === "ArrowUp") next = (index - 1 + available.length) % available.length
        else if (event.key === "Home") next = 0
        else if (event.key === "End") next = available.length - 1
        else return
        event.preventDefault()
        available[next]?.focus()
      })
      items.forEach((item) => item.addEventListener("click", () => {
        pauseTour()
        const tab = tabs.find((tab) => tab.dataset.tab === item.dataset.revealTab)!
        tab.hidden = false
        item.disabled = true
        closeMenu()
        selectTab(group, tab)
        tab.focus()
      }))
      add.parentElement!.addEventListener("focusout", (event) => {
        if (!add.parentElement!.contains(event.relatedTarget as Node | null)) closeMenu()
      })
    })
    document.addEventListener("click", (event) => {
      demo.querySelectorAll<HTMLElement>("[data-tab-menu]:not([hidden])").forEach((menu) => {
        if (menu.parentElement!.contains(event.target as Node)) return
        menu.hidden = true
        menu.parentElement!.querySelector("[data-add-tab]")!.setAttribute("aria-expanded", "false")
      })
    })

    const sendSample = () => {
      pauseTour()
      if (pending !== undefined) return
      pending = setTimeout(() => {
        pending = undefined
        setSending(false)
        status.textContent = `${active.dataset.name} complete. Sample response: ${active.dataset.status}.`
      }, 450)
      setSending(true)
      status.textContent = "Sending sample request."
    }
    examples.forEach((example) => example.querySelector<HTMLButtonElement>("[data-send]")!.addEventListener("click", sendSample))
    footerSend.addEventListener("click", sendSample)
    demo.querySelectorAll<HTMLButtonElement>("[data-request], [data-send], [role=tab], [data-footer-action], [data-footer-send], [data-add-tab]").forEach((button) => { button.disabled = false })

    const chapters = [...demo.querySelectorAll<HTMLButtonElement>("[data-tour-option]")]
    const chapterSelect = demo.querySelector<HTMLButtonElement>("[data-tour-select]")!
    const chapterTitle = demo.querySelector<HTMLElement>("[data-tour-title]")!
    const chapterMenu = demo.querySelector<HTMLElement>(".tour-picker [popover]")!
    const play = demo.querySelector<HTMLButtonElement>("[data-tour-play]")!
    const playbackIcon = play.querySelector("path")!
    const previous = demo.querySelector<HTMLButtonElement>("[data-tour-previous]")!
    const next = demo.querySelector<HTMLButtonElement>("[data-tour-next]")!
    const progress = demo.querySelector<HTMLElement>("[data-tour-progress]")!
    const tree = demo.querySelector<HTMLElement>(".request-tree")!
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)")
    let chapterIndex = 0
    let playing = false
    let autostart = !reducedMotion.matches
    let tourTimer: ReturnType<typeof setTimeout> | undefined
    let progressAnimation: Animation | undefined

    const updatePlayback = () => {
      playbackIcon.setAttribute("d", playing ? "M8 5v14M16 5v14" : "m9 5 11 7-11 7z")
      play.title = playing ? "Pause tour" : "Play tour"
      play.setAttribute("aria-label", play.title)
      status.setAttribute("aria-live", playing ? "off" : "polite")
      previous.disabled = chapterIndex === 0
      next.disabled = chapterIndex === chapters.length - 1
    }
    const pauseTour = () => {
      autostart = false
      playing = false
      clearTimeout(tourTimer)
      progressAnimation?.pause()
      updatePlayback()
    }
    const fitTourFolders = () => {
      const folders = [...tree.querySelectorAll<HTMLDetailsElement>(".request-folder")]
      const activeFolder = folders.findIndex((folder) => folder.querySelector('[aria-pressed="true"]'))
      folders.forEach((folder, index) => { folder.open = index === activeFolder })
      if (!playing || !tree.clientHeight) return
      let openCount = 1
      const nearest = [...folders.keys()].sort((a, b) => Math.abs(a - activeFolder) - Math.abs(b - activeFolder))
      for (const index of nearest) {
        const folder = folders[index]!
        if (folder.open) continue
        folder.open = true
        if (tree.scrollHeight > tree.clientHeight) folder.open = false
        else if (++openCount === 4) break
      }
    }
    const updateChapter = (index: number) => {
      progressAnimation?.cancel()
      progressAnimation = undefined
      if (index >= 0) chapterIndex = index
      chapterTitle.textContent = index >= 0 ? chapters[index]!.dataset.title! : active.dataset.name!
      const title = index >= 0 ? `${index + 1} / ${chapters.length} · ${chapters[index]!.dataset.title}` : active.dataset.name!
      chapterSelect.setAttribute("aria-label", `Tour chapter, ${title} selected`)
      chapterSelect.title = title
      chapters.forEach((chapter, i) => chapter.setAttribute("aria-checked", String(i === index)))
      updatePlayback()
    }
    const showChapter = (index: number) => {
      const chapter = chapters[index]!
      const choice = choices.find((button) => button.dataset.request === chapter.dataset.tourOption)!
      selectRequest(choice)
      fitTourFolders()
      const response = active.querySelector<HTMLElement>('.response')!
      selectTab(response, response.querySelector<HTMLButtonElement>(`[data-tab="${chapter.dataset.responseTab}"]`)!)
      activatePane(active.querySelector<HTMLElement>(`${chapter.dataset.responseTab === "Body" ? ".request" : ".response"} [role=tabpanel]:not([hidden])`)!)
      active.querySelectorAll<HTMLElement>(".tab-panel").forEach((panel) => { panel.scrollTop = 0; panel.scrollLeft = 0 })
      const row = choice.getBoundingClientRect()
      const bounds = tree.getBoundingClientRect()
      if (row.top < bounds.top) tree.scrollTop += row.top - bounds.top
      else if (row.bottom > bounds.bottom) tree.scrollTop += row.bottom - bounds.bottom
      updateChapter(index)
      status.textContent = `${chapter.dataset.title}. ${chapter.dataset.description}`
    }
    const scheduleChapter = () => {
      clearTimeout(tourTimer)
      if (!playing || chapterMenu.matches(":popover-open")) return
      const duration = Number(chapters[chapterIndex]!.dataset.duration)
      progressAnimation ??= progress.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration, fill: "forwards", easing: reducedMotion.matches ? `steps(${Math.ceil(duration / 1000)})` : "linear",
      })
      progressAnimation.play()
      tourTimer = setTimeout(() => {
        showChapter((chapterIndex + 1) % chapters.length)
        scheduleChapter()
      }, Math.max(0, duration - Number(progressAnimation.currentTime ?? 0)))
    }
    choices.forEach((choice) => choice.addEventListener("click", () => {
      pauseTour()
      selectRequest(choice)
      updateChapter(chapters.findIndex((chapter) => chapter.dataset.tourOption === choice.dataset.request))
    }))
    chapterMenu.addEventListener("beforetoggle", (event) => {
      if (event.newState !== "open") return
      clearTimeout(tourTimer)
      progressAnimation?.pause()
    })
    chapterMenu.addEventListener("toggle", () => {
      if (!chapterMenu.matches(":popover-open")) scheduleChapter()
    })
    chapters.forEach((option, index) => option.addEventListener("click", () => {
      showChapter(index)
      scheduleChapter()
    }))
    previous.addEventListener("click", () => { showChapter(chapterIndex - 1); scheduleChapter() })
    next.addEventListener("click", () => { showChapter(chapterIndex + 1); scheduleChapter() })
    play.addEventListener("click", () => {
      if (playing) { pauseTour(); return }
      autostart = false
      playing = true
      showChapter(chapterIndex)
      scheduleChapter()
    })
    demo.querySelectorAll("summary").forEach((summary) => summary.addEventListener("click", pauseTour))
    reducedMotion.addEventListener("change", () => { if (reducedMotion.matches) pauseTour() })
    new ResizeObserver(() => { if (playing) fitTourFolders() }).observe(tree)
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting || entry.intersectionRatio < 0.5) return
      observer.disconnect()
      if (!autostart) return
      autostart = false
      playing = true
      fitTourFolders()
      updatePlayback()
      scheduleChapter()
    }, { threshold: [0, 0.5] })
    observer.observe(demo)
    play.disabled = false
    updatePlayback()
    activatePane(active.querySelector<HTMLElement>('.request [role=tabpanel]:not([hidden])')!)
  })
</script>

<style>
  .noodle-demo {
    --demo-stripe: color-mix(in srgb, var(--demo-background-panel), var(--demo-background-element));
    margin-top: clamp(3rem, 9vw, 8rem);
    --demo-line: 22px;
    font: 400 0.8125rem/var(--demo-line) var(--font-mono);
    color: var(--demo-text);
    color-scheme: dark;
  }
  .noodle-demo [hidden] { display: none !important; }
  .collection-label .tour-title-trigger { padding: 0; color: var(--demo-text); }
  .collection-label :global(.tour-picker) { min-width: 0; }
  .tour-title-trigger .select-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .collection-label .select-chevron { width: 0.65ch; height: 0.6em; }
  .tour-buttons { display: flex; gap: 0.25rem; }
  .tour-buttons button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: 8px; color: var(--demo-text-muted); }
  .tour-buttons button:disabled { opacity: 0.35; }
  .tour-buttons button:not(:disabled):is(:hover, :focus-visible) { color: var(--demo-primary); }
  .tour-buttons svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .tour-progress {
    position: absolute;
    inset: -5px -1px auto;
    height: 20px;
    padding: 4px 0 0;
    border-radius: 16px 16px 0 0 / 100% 100% 0 0;
    background: var(--demo-border-subtle);
    mask: linear-gradient(var(--demo-text) 0 0) content-box, linear-gradient(var(--demo-text) 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .tour-progress span { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .tour-controls button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .terminal {
    position: relative;
    padding: 0 2ch;
    background: var(--demo-background-panel);
    border: 1px solid var(--demo-border-subtle);
    border-radius: 16px;
    box-shadow: 0 28px 70px color-mix(in srgb, var(--demo-background) 28%, transparent);
  }
  .noodle-demo ::selection { color: var(--demo-background-panel); background: var(--demo-primary); }
  .noodle-demo :is(pre, .tab-panel, .url-bar code, .request-tree, .footer-context) { scrollbar-width: thin; scrollbar-color: var(--demo-border-active) var(--demo-background); }
  .noodle-demo :is(button, summary, [tabindex]):focus-visible { outline: 2px solid var(--demo-primary); outline-offset: -2px; }
  .terminal-title, .terminal-title > div, .environment, .terminal-foot { display: flex; align-items: center; }
  .terminal-title { justify-content: space-between; flex-wrap: wrap; gap: 0 2ch; min-height: 44px; padding: 0 1ch; }
  .terminal-title > div { flex-wrap: wrap; gap: 0 2ch; min-width: 0; }
  .terminal-title > .terminal-identity { flex: 1; flex-wrap: nowrap; }
  .terminal-brand, .collection-label { white-space: nowrap; }
  .collection-label { display: inline-flex; align-items: center; gap: 2ch; min-width: 0; }
  .terminal-version { color: var(--demo-text-muted); }
  .chevron { flex: none; display: inline-block; width: 1ch; height: 0.6em; fill: currentColor; }
  .terminal-title > .terminal-actions { flex: none; flex-wrap: nowrap; margin-left: auto; }
  .terminal-title strong, .variable { color: var(--demo-primary); }
  .title-divider, .terminal-foot, .folder-name { color: var(--demo-text-muted); }
  .environment { gap: 1ch; }
  .environment svg { width: 14px; height: 14px; fill: none; stroke: var(--demo-success); stroke-width: 1; }
  .terminal-layout { display: grid; grid-template-columns: minmax(190px, 25%) minmax(0, 1fr); align-items: stretch; gap: 2ch; }
  .pane { position: relative; min-width: 0; background: var(--demo-background-panel); border: 1px solid var(--demo-border-subtle); }
  .pane-heading, .collection > .pane-title { position: absolute; top: calc(var(--demo-line) / -2); right: 1ch; padding: 0 1ch; background: var(--demo-background-panel); }
  .pane-heading { display: flex; align-items: center; gap: 2ch; }
  .pane-title { color: var(--demo-text-muted); font: inherit; }
  .pane.is-active { border-color: var(--demo-primary); }
  .pane.is-active .pane-title { color: var(--demo-primary); }
  .request-tree { position: absolute; inset: calc(var(--demo-line) / 2) 1ch; overflow: auto; }
  .folder-name { display: flex; align-items: center; gap: 1ch; min-height: 44px; padding: 0 1ch; cursor: pointer; list-style: none; }
  .folder-name::-webkit-details-marker { display: none; }
  .folder-name:hover { background: var(--demo-background-element); }
  .folder-name svg { width: 0.65ch; margin-inline: 0.175ch; }
  .request-folder:not([open]) .folder-name svg { transform: rotate(-90deg); }
  button { color: inherit; font: inherit; border: 0; background: transparent; cursor: pointer; }
  button:disabled { cursor: default; }
  .terminal button:not(:disabled):not(.add-tab):not(.send):hover { background: var(--demo-background-element); }
  .request-choice { display: flex; align-items: center; gap: 2ch; width: 100%; min-height: 44px; padding: 0 1ch 0 3ch; text-align: left; border-left: 1px solid transparent; }
  .request-choice > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .request-choice[aria-pressed="true"] { background: var(--demo-background-element); border-left-color: var(--demo-primary); }
  .method { flex: none; width: 5ch; }
  .post { color: var(--demo-warning); }
  .get { color: var(--demo-success); }
  .patch, .put { color: var(--demo-info); }
