---
import { Image } from "astro:assets"
import logoMark from "../assets/noodle/logo-simpler.png"
---

<nav id="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a href="/" class="wordmark" aria-label="Noodle home">
      <Image src={logoMark} class="brand-mark" alt="" width={54} loading="eager" />
      <span class="brand-name">noodle</span>
    </a>

    <div class="nav-links" id="primary-navigation">
      <a href="/docs/">Docs</a>
      <a href="/#features">Features</a>
      <a href="/blog/">Blog</a>
      <a href="https://github.com/wilfredinni/noodle/releases" target="_blank" rel="noopener noreferrer">Releases</a>
      <a class="install-link" href="/docs/getting-started/installation/">Install Noodle</a>
      <a class="github-link" href="https://github.com/wilfredinni/noodle" target="_blank" rel="noopener noreferrer" aria-label="Noodle on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.17v3.22c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
        <span class="github-label">GitHub</span>
      </a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-label="Open navigation menu" aria-controls="primary-navigation" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</nav>

<style>
  #site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    min-height: 72px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1200px);
    min-height: 72px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg);
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 32px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .nav-links a {
    color: color-mix(in srgb, var(--fg) 72%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .nav-links .github-link {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .github-link:hover {
    border-color: var(--accent);
  }

  .github-link svg {
    width: 18px;
    height: 18px;
  }

  .github-label {
    display: none;
  }

  .nav-links .install-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    color: var(--ivory-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 8px;
    font-weight: 600;
  }

  .nav-links .install-link:hover {
    color: var(--ivory-ink);
    background: var(--accent-dim);
    border-color: var(--accent-dim);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 6px auto;
    background: var(--fg);
    transition: transform 180ms ease;
  }

  @media (max-width: 760px) {
    .nav-inner {
      min-height: 64px;
      padding-inline: 1rem;
    }

    .nav-links {
      position: absolute;
      inset: 64px 0 auto;
      display: none;
      align-items: stretch;
      padding: 0.8rem 1rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    #site-nav.menu-open .nav-links {
      display: grid;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      border-bottom: 1px solid var(--rule);
    }

    .nav-links .install-link {
      justify-content: center;
      margin-top: 0.5rem;
      color: var(--ivory-ink);
      border: 1px solid var(--accent);
    }

    .nav-links .github-link {
      display: flex;
      width: 100%;
      border: 0;
      border-bottom: 1px solid var(--rule);
      border-radius: 0;
    }

    .github-label {
      display: inline;
      margin-left: 0.75rem;
    }

    .menu-toggle {
      display: block;
    }

    #site-nav.menu-open .menu-toggle span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    #site-nav.menu-open .menu-toggle span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle")
  const nav = document.getElementById("site-nav")

  if (toggle && nav) {
    const close = () => {
      nav.classList.remove("menu-open")
      toggle.setAttribute("aria-expanded", "false")
      toggle.setAttribute("aria-label", "Open navigation menu")
    }

    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("menu-open")
      toggle.setAttribute("aria-expanded", String(isOpen))
      toggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu")
    })
    document.addEventListener("keydown", (event) => event.key === "Escape" && close())
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", close))
  }
</script>
