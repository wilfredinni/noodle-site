---
import { Image } from "astro:assets"
import logoMark from "../assets/noodle/logo-simple.png"
---

<nav id="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a href="/" class="wordmark" aria-label="Noodle home">
      <Image src={logoMark} class="brand-mark" alt="" width={54} loading="eager" />
      <span class="brand-name">noodle</span>
      <span class="brand-kind">REST CLIENT</span>
    </a>

    <div class="nav-links" id="primary-navigation">
      <a href="/docs/">Docs</a>
      <a href="/blog/">Blog</a>
      <a href="https://github.com/wilfredinni/noodle" target="_blank" rel="noopener noreferrer">Source</a>
      <a href="https://github.com/wilfredinni/noodle/releases" target="_blank" rel="noopener noreferrer">Releases</a>
      <a class="install-link" href="/docs/getting-started/installation/">Install Noodle</a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-label="Open navigation menu" aria-controls="primary-navigation" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</nav>

<style>
  #site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    min-height: 72px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1200px);
    min-height: 72px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg);
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 32px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    line-height: 1;
  }

  .brand-kind {
    margin-left: 0.15rem;
    color: var(--noodle);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.18em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }

  .nav-links a {
    color: color-mix(in srgb, var(--fg) 72%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .nav-links .install-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    color: var(--ivory-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 8px;
    font-weight: 600;
  }

  .nav-links .install-link:hover {
    color: var(--ivory-ink);
    background: var(--accent-dim);
    border-color: var(--accent-dim);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 6px auto;
    background: var(--fg);
    transition: transform 180ms ease;
  }

  @media (max-width: 760px) {
    .nav-inner {
      min-height: 64px;
      padding-inline: 1rem;
    }

    .nav-links {
      position: absolute;
      inset: 64px 0 auto;
      display: none;
      align-items: stretch;
      padding: 0.8rem 1rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    #site-nav.menu-open .nav-links {
      display: grid;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      border-bottom: 1px solid var(--rule);
    }

    .nav-links .install-link {
      justify-content: center;
      margin-top: 0.5rem;
      color: var(--ivory-ink);
      border: 1px solid var(--accent);
    }

    .brand-kind {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    #site-nav.menu-open .menu-toggle span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    #site-nav.menu-open .menu-toggle span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle")
  const nav = document.getElementById("site-nav")

  if (toggle && nav) {
    const close = () => {
      nav.classList.remove("menu-open")
      toggle.setAttribute("aria-expanded", "false")
      toggle.setAttribute("aria-label", "Open navigation menu")
    }

    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("menu-open")
      toggle.setAttribute("aria-expanded", String(isOpen))
      toggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu")
    })
    document.addEventListener("keydown", (event) => event.key === "Escape" && close())
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", close))
  }
</script>
